#!/bin/sh

##############################################################################
#
#  Gradle start up script for POSIX generated for the Gradle Wrapper.
#
##############################################################################

APP_HOME=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
CLASSPATH="$APP_HOME/gradle/wrapper/gradle-wrapper.jar"

if [ -n "$JAVA_HOME" ] ; then
    JAVACMD="$JAVA_HOME/bin/java"
else
    JAVACMD="java"
fi

if ! command -v "$JAVACMD" >/dev/null 2>&1; then
    echo "ERROR: JAVA_HOME is not set and java was not found." >&2
    exit 1
fi

DEFAULT_JVM_OPTS='-Xmx64m -Xms64m'

# JVM options and the classpath must come before the main class. The program
# arguments ("$@": task names, --flags, -D properties) must come after it,
# otherwise java reads the first one as the main class name.
# shellcheck disable=SC2086
exec "$JAVACMD" $DEFAULT_JVM_OPTS -classpath "$CLASSPATH" org.gradle.wrapper.GradleWrapperMain "$@"
